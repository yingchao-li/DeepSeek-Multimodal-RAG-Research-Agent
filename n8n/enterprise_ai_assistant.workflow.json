        "jsCode": "const response = $json ?? {};\nif (response.error && !response.status) {\n  return [{ json: { status: 'service_unavailable', answer: '', sources: [], mode: 'unknown', message: response.error.message ?? String(response.error) } }];\n}\nreturn [{ json: {\n  status: response.status ?? 'backend_error',\n  answer: response.answer ?? '',\n  sources: Array.isArray(response.sources) ? response.sources : [],\n  mode: response.mode ?? 'unknown',\n  message: response.message ?? null\n} }];"
