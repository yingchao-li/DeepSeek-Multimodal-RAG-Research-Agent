# Export these variables in your shell or PyCharm Run Configuration.
# Alternatively use .streamlit/secrets.toml. The app does not auto-load .env files.
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=2048
EMBEDDING_MODEL=all-MiniLM-L6-v2
MODEL_DEVICE=cpu

# Enterprise FastAPI / n8n demo. "mock" uses real local hybrid retrieval but no paid LLM call.
ENTERPRISE_ASSISTANT_MODE=mock
RAG_CORPUS_PATH=evaluation/example.json
RAG_TOP_K=5
RAG_REQUEST_TIMEOUT_SECONDS=30
RAG_CONTEXT_PACKING=false
# ENTERPRISE_MOCK_DELAY_SECONDS=0
# ALLOW_MODEL_DOWNLOAD=false
# Optional: JSON mapping model names to your current USD rates per million tokens.
# No price is assumed when this is absent. This is an estimate, not an invoice.
# DEEPSEEK_PRICES_JSON='{"deepseek-flash":{"input":0.0,"output":0.0}}'
